<?xml version="1.0" encoding="UTF-8"?>
<!--
  Samsung Tizen TV widget configuration. tools/build/build-tv.ts copies this file into
  dist/tv/tizen and replaces {{version}} with apps/tv/package.json "version".
  PLACEHOLDERS until release engineering (RELAY step 45): the widget id URL and the
  10-character package id "ZomaIPTV01". Both are permanent once the app is published.
-->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://zoma-iptv.invalid/tv" version="{{version}}" viewmodes="maximized">
    <tizen:application id="ZomaIPTV01.Zoma" package="ZomaIPTV01" required_version="4.0"/>
    <tizen:profile name="tv-samsung"/>
    <name>Zoma</name>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <!-- Remote keys beyond arrows/Enter/Back (tvinputdevice.registerKey). -->
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <!-- Model and firmware for the hello screen and diagnostics (webapis.productinfo). -->
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
    <!-- Users' own playlist and EPG hosts can be anywhere (spike S7). -->
    <access origin="*" subdomains="true"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
