{
  "name": "lablo-iptv",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @lablo/app-tv dev",
    "build:tv": "tsx tools/build/build-tv.ts",
    "release:check": "tsx tools/build/release-check.ts",
    "device": "tsx tools/device/device.ts",
    "tv": "tsx tools/tv/tv.ts",
    "mock": "tsx apps/mock-provider/src/main.ts",
    "mock:media": "tsx apps/mock-provider/src/media-cli.ts generate",
    "mock:open-movies": "tsx apps/mock-provider/src/media-cli.ts open-movies",
    "fixtures": "tsx tools/fixtures/fixtures.ts",
    "sign-config": "tsx tools/sign-config/sign-config.ts",
    "fonts": "tsx tools/fonts/fonts.ts",
    "bench": "node --expose-gc --import tsx tools/bench/bench.ts",
    "epg:report": "node --import tsx tools/bench/epg-report.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --parallel run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:media": "vitest run -c vitest.media.config.ts",
    "e2e": "playwright test",
    "lab:scale": "playwright test --project lab-scale",
    "lab:media": "playwright test --project lab-media",
    "e2e:media": "playwright test --project playback-media",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build:tv && pnpm e2e",
    "verify:engines": "tsx tools/engines/verify-engines.ts",
    "verify:media": "pnpm fixtures && pnpm test:media && pnpm lab:media && pnpm e2e:media",
    "web:db": "docker compose -f apps/web/docker-compose.yml up -d --wait",
    "web:db:down": "docker compose -f apps/web/docker-compose.yml down",
    "web:dev": "pnpm --filter @lablo/web dev",
    "build:web": "pnpm --filter @lablo/web build",
    "test:web": "vitest run -c vitest.web.config.ts",
    "e2e:web": "playwright test -c playwright.web.config.ts",
    "verify:web": "pnpm test:web && pnpm build:web && pnpm e2e:web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lablo/core": "workspace:*",
    "@lablo/crypto": "workspace:*",
    "@lablo/data": "workspace:*",
    "@lablo/protocol": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "globals": "^16.5.0",
    "postcss-rtlcss": "6.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
