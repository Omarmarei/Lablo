{
  "name": "@lablo/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "IndexedDB schema and migrations, ingest and query workers, typed worker RPC, DataClient.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./query.worker": "./src/query.worker.ts",
    "./ingest.worker": "./src/ingest.worker.ts",
    "./epg.worker": "./src/epg.worker.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lablo/core": "workspace:*",
    "@lablo/crypto": "workspace:*",
    "@lablo/protocol": "workspace:*",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.6"
  }
}
