{
  "name": "@lablo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The backend: Next.js route handlers (/v1/*), later the phone pairing page (/p) and the legal pages. It never fetches a user-supplied URL and never relays streams.",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lablo/crypto": "workspace:*",
    "@lablo/protocol": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.4",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.1"
  }
}
