# Copy to apps/web/.env (gitignored) for local development: `pnpm web:db` starts this database.
# Next.js, the Prisma CLI (prisma.config.ts) and `pnpm test:web` read it. No password: the local
# Postgres trusts connections from this machine only (apps/web/docker-compose.yml).
